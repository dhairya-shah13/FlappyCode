{
  "name": "@flappycode/core",
  "version": "0.1.0",
  "description": "Core orchestration engine: registry, router, flappyauto, agents, rules, and root-jailed tools",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@flappycode/protocol": "workspace:*",
    "@flappycode/providers": "workspace:*",
    "@flappycode/storage": "workspace:*",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
