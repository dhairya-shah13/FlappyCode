{
  "id": "kilocode",
  "name": "Kilocode",
  "type": "openai_compatible",
  "baseUrl": "https://api.kilocode.ai/v1",
  "authScheme": "bearer",
  "envKeyName": "KILOCODE_API_KEY",
  "discovery": {
    "endpoint": "/models",
    "supported": true
  },
  "supportsToolCalls": true,
  "supportsStreaming": true,
  "dataUsePolicy": {
    "trainsOnData": "unknown",
    "sourceUrl": "https://kilocode.ai/terms",
    "verifiedAt": "2026-09-29",
    "details": "ToS data usage clause requires human legal verification."
  },
  "rateLimits": {
    "freeTier": {
      "requestsPerMinute": 15,
      "notes": "Community free access tier."
    }
  },
  "documentationUrl": "https://kilocode.ai/docs",
  "verifiedAt": "2026-09-29",
  "needsHumanVerification": true,
  "notes": "Added to NEEDS_HUMAN_VERIFICATION pending confirmation of training opt-out policy."
}
