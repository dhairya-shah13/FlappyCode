{
  "id": "openai",
  "name": "OpenAI",
  "type": "openai_compatible",
  "baseUrl": "https://api.openai.com/v1",
  "authScheme": "bearer",
  "envKeyName": "OPENAI_API_KEY",
  "discovery": {
    "endpoint": "/models",
    "supported": true
  },
  "supportsToolCalls": true,
  "supportsStreaming": true,
  "dataUsePolicy": {
    "trainsOnData": "no",
    "sourceUrl": "https://openai.com/enterprise-privacy/",
    "verifiedAt": "2026-09-29",
    "details": "OpenAI does not use data submitted by API customers to train or improve models unless customer explicitly opts in."
  },
  "rateLimits": {
    "paidTier": {
      "requestsPerMinute": 500,
      "tokensPerMinute": 30000
    }
  },
  "documentationUrl": "https://platform.openai.com/docs/api-reference",
  "verifiedAt": "2026-09-29",
  "needsHumanVerification": false,
  "notes": "Paid provider for GPT-4o, GPT-4o-mini, and o1/o3 reasoning models. No day-one permanent free tier."
}
