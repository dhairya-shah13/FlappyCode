{
  "name": "flappycode",
  "version": "0.0.0-dev",
  "description": "Your connected providers. All the free models. One powerful coding agent.",
  "type": "module",
  "bin": {
    "flappycode": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/copy-cli-assets.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/block-publish.mjs"
  },
  "dependencies": {
    "eventsource-parser": "^3.0.4",
    "ink": "^5.1.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@flappycode/core": "workspace:*",
    "@flappycode/protocol": "workspace:*",
    "@flappycode/providers": "workspace:*",
    "@flappycode/storage": "workspace:*",
    "@flappycode/tui": "workspace:*",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
